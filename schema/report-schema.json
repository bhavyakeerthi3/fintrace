{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinTrace auditable review report",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "data_classification",
    "company",
    "period",
    "stages",
    "ingestion",
    "specialist_findings",
    "aggregated_findings",
    "reconciliations",
    "calculations",
    "evidence_retrieval",
    "second_pass",
    "quote_validation",
    "risk_memos",
    "cross_period",
    "human_signoff",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "data_classification": { "enum": ["fictional_demo", "historical_adjudicated"] },
    "stages": { "type": "array", "minItems": 8 },
    "ingestion": {
      "type": "object",
      "required": ["claims"],
      "properties": { "claims": { "type": "array" } }
    },
    "specialist_findings": {
      "type": "object",
      "required": ["revenue", "related_party", "cash_flow", "language"]
    },
    "aggregated_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "claim_quote", "evidence_reference", "severity", "rationale", "sources"]
      }
    },
    "reconciliations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "claimed_value", "computed_value", "gap", "tolerance", "status"],
        "properties": { "status": { "enum": ["aligned", "flagged"] } }
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "calculation"]
      }
    },
    "evidence_retrieval": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "candidate_evidence"]
      }
    },
    "second_pass": {
      "type": "object",
      "required": ["explained", "unresolved"],
      "properties": {
        "explained": { "type": "array" },
        "unresolved": { "type": "array" }
      }
    },
    "quote_validation": { "type": "array" },
    "risk_memos": { "type": "array" },
    "cross_period": { "type": "array" },
    "human_signoff": {
      "type": "object",
      "required": ["status", "analyst", "reviewed_at", "decisions"],
      "properties": {
        "status": { "enum": ["pending", "complete"] },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_id", "decision", "analyst_note"],
            "properties": { "decision": { "enum": ["accept", "reject", "needs_review"] } }
          }
        }
      }
    },
    "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
