{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinTrace evidence report",
  "type": "object",
  "required": ["schema_version", "run_id", "data_classification", "company", "period", "stages", "reconciliations", "second_pass", "risk_memos", "human_signoff", "integrity"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "data_classification": { "enum": ["fictional_demo", "historical_adjudicated"] },
    "reconciliations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "claimed_value", "computed_value", "gap", "tolerance", "status"],
        "properties": { "status": { "enum": ["aligned", "flagged"] } }
      }
    },
    "second_pass": {
      "type": "object",
      "required": ["explained", "unresolved", "aligned"],
      "properties": {
        "explained": { "type": "array" },
        "unresolved": { "type": "array" },
        "aligned": { "type": "array" }
      }
    },
    "human_signoff": {
      "type": "object",
      "required": ["status", "analyst", "approved_at"],
      "properties": { "status": { "enum": ["pending", "approved"] } }
    },
    "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
